# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 生产配置与加密备份使用仓库外目录；防止临时复制后误提交。
runtime.env
maintenance.env
restore-admin.env
backup.key
*.isb
*.isb.sha256

# vercel
.vercel

# claude
.claude/
.codex/hooks.json

# typescript
*.tsbuildinfo
next-env.d.ts

# dev artifacts
.scratch/dev-server.log
.scratch/screenshots/
