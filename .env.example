# v1.3 MySQL 初始化：网站运行时使用 MYSQL_USER，勿使用 root。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pm_assistant
MYSQL_USER=pm_assistant_app
MYSQL_PASSWORD=replace-with-a-strong-app-password
MYSQL_APP_HOST=localhost
# 仅 npm run db:init / verify:mysql-init 使用，真实维护者凭据只写本机 .env.local。
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=replace-with-your-local-root-password
MYSQL_REQUIRED_VERSION=9.7.2
AUTH_SECRET=your-random-secret-here
# 本地验证默认使用固定回放，不调用任何模型。
AI_MODE=replay
# 真实 DeepSeek 对话时改为 live，并在下一行填写 DeepSeek API Key。
AI_API_KEY=your-deepseek-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# v1.44 邮箱验证码：腾讯云 SES API，使用仅允许 SendEmail 的子用户。
# 凭据只保存到受限运行配置/密码管理器，勿提交真实值。模板和发信地址须在同一地域就绪。
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_REGISTER_TEMPLATE_ID=
TENCENT_SES_RESET_TEMPLATE_ID=
EMAIL_FROM=

# v1.44 最小运营后台：指定现有账号的完整邮箱，多个用英文逗号分隔；留空无人有权限。
# 仅在受控服务端环境配置，不使用 NEXT_PUBLIC_，不要填写测试身份到生产。
ADMIN_EMAILS=

# v1.44 人工充值：填写并核实真实运营者微信；留空不开放联系渠道。
# 仅服务端读取，禁止使用示例/占位值；修改配置后重启应用。
RECHARGE_WECHAT_CONTACT=
