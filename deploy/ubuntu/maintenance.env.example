# 仅初始化/迁移时手动使用，绝不可加到网站 systemd EnvironmentFile。
# 同时加载 runtime.env 内的应用账号配置，再加载本文件。
MYSQL_ADMIN_HOST=127.0.0.1
MYSQL_ADMIN_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=REPLACE_WITH_MAINTAINER_PASSWORD
# 更新已有库时可使用专用 DDL 账号，取代运行账号。
MYSQL_MIGRATION_USER=ideastage_migration
MYSQL_MIGRATION_PASSWORD=REPLACE_WITH_MIGRATION_PASSWORD
