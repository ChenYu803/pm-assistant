# 复制至 /etc/ideastage/runtime.env，权限 0600，勿提交真实值。
NODE_ENV=production
AUTH_URL=https://ideastage.top
AUTH_TRUST_HOST=true
AUTH_SECRET=REPLACE_WITH_RANDOM_64_HEX
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ideastage
MYSQL_USER=ideastage_app
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_64_HEX
MYSQL_APP_HOST=localhost
MYSQL_REQUIRED_VERSION=9.7.2
# 首次验证先 replay，确认后显式 live；不要向体验者冒充实时生成。
AI_MODE=replay
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODE=REPLACE_WITH_RANDOM_INVITE_CODE
AI_DAILY_USER_LIMIT=10
AI_DAILY_SITE_LIMIT=100
# 当前恢复/停止控制按单进程部署，禁止 PM2 cluster 或多实例共用本库。
IDEASTAGE_SINGLE_INSTANCE=1
NEXT_TELEMETRY_DISABLED=1
